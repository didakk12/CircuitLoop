# Copy this file to .env and fill in real values. Never commit .env
# (the repo-root .gitignore already excludes it).

# --- Neo4j (required) -------------------------------------------------------
# Neo4j is the RAG corpus store AND the vector index: datasheet chunks, their
# metadata and their embeddings all live on (:DatasheetChunk) nodes, and
# similarity search runs against Neo4j's own vector index. The service will
# not start without these. Use the same values as backend/.env — both
# processes talk to the same database.
#
# This service reads/writes ONLY (:DatasheetChunk). User, Scan, Component and
# TestResult data remain exclusively the TypeScript backend's
# (ML_SERVICE_INTEGRATION_PLAN.md §7); see ml-service/neo4j_store.py for the
# full rationale.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
# Optional: named database within the DBMS. Leave blank for the server default.
NEO4J_DATABASE=

# --- Service binding (optional) ---------------------------------------------
# Bind address. Kept at 127.0.0.1 (localhost-only) intentionally — this
# service is internal-only, never exposed to the browser or network.
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=8001

# Max accepted image upload size, in bytes. Default 10MB.
ML_SERVICE_MAX_IMAGE_BYTES=10485760

# --- Gemini: the ONLY component detector -------------------------------------
# There is no local fallback model. Leaving GEMINI_API_KEY blank does not stop
# the service from starting (/search still works), but every /detect request
# will 503 until it's set. The key is a secret — it is sent only as the
# Gemini request's own header, is never logged, and never reaches the frontend.
GEMINI_API_KEY=
# Verified against the live API: gemini-2.5-flash-lite returns 404 "no longer
# available to new users". Change this value to switch models without touching
# any code.
GEMINI_MODEL=gemini-3.5-flash-lite
# Per-request timeout, in seconds. Default 60: detection measures ~6s on a
# dense board, but the ceiling is kept well clear of that since there is no
# fallback to fall back to on a timeout.
GEMINI_TIMEOUT_S=60
