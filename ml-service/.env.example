# All optional — every value has a safe default in config.py. No secrets
# exist here today (no Neo4j access, no LLM key — this service only does
# detection + retrieval, see ML_SERVICE_INTEGRATION_PLAN.md §2/§6/§7).

# Bind address. Kept at 127.0.0.1 (localhost-only) intentionally — this
# service is internal-only, never exposed to the browser or network.
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=8001

# Max accepted image upload size, in bytes. Default 10MB.
ML_SERVICE_MAX_IMAGE_BYTES=10485760

# Only needed if the Tesseract OCR binary isn't on PATH / at the Windows
# default install location — see detection.py.
TESSERACT_CMD=
