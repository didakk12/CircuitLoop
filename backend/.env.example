# Copy this file to .env and fill in real values. Never commit .env.

# --- Neo4j (required) ---------------------------------------------------
# Bolt connection URI, e.g. neo4j://127.0.0.1:7687 or neo4j+s://<host> for an
# encrypted remote connection.
NEO4J_URI=
# Neo4j database user.
NEO4J_USER=
# Neo4j database password.
NEO4J_PASSWORD=
# Optional: named database within the DBMS. Leave blank to use the server default.

# --- LLM / RAG assistant --------------------------------------------------
# The assistant has two providers, tried in order:
#   1. Gemini (services/geminiClient.ts) — PRIMARY
#   2. Groq   (services/llmClient.ts)    — FALLBACK, used only when Gemini
#      fails, times out, or is unconfigured
#
# With NEITHER configured the assistant returns a generic "temporarily
# unavailable" message and NO component or datasheet content — without an LLM
# there is nothing to scope-check a question, so nothing component-specific may
# be returned. It does not fall back to dumping raw retrieval results.
#
# Both keys are secrets: they are sent only as their own provider's request
# header, are never logged, and never reach the frontend.

# Gemini API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional: override the Gemini model id. Defaults to gemini-3.5-flash-lite.
# Verified against the live API: gemini-2.5-flash-lite returns 404 "no longer
# available to new users" and names this as its replacement.
GEMINI_MODEL=

# Groq API key (https://console.groq.com).
GROQ_API_KEY=
# Optional: override the Groq model id. Defaults to openai/gpt-oss-120b
# (verified current/production in Groq's docs as of this writing) if unset.
GROQ_MODEL=

# How many datasheet chunks to retrieve per assistant question, before the
# relevance threshold is applied. Default 5.
CIRCUITLOOP_RAG_TOP_K=
# Minimum cosine similarity (0-1) a datasheet chunk must reach to be shown to
# the LLM at all; below it, the prompt says no relevant datasheet evidence was
# found rather than passing weak matches off as relevant. Default 0.65,
# calibrated against the real corpus — off-topic queries top out near 0.63 and
# genuine electronics queries start near 0.67. Raise it to be stricter about
# what counts as evidence; lower it to let more marginal excerpts through.
# The backend refuses to start if this is set outside 0-1.
CIRCUITLOOP_RAG_MIN_SCORE=

# --- Internal ML service (optional — defaults to http://127.0.0.1:8001) ---
# Base URL of the internal Python ML service (ml-service/), see
# ML_SERVICE_INTEGRATION_PLAN.md. Not secret; the backend starts fine
# without it and only fails calls that need it.
ML_SERVICE_URL=
# Max accepted size for POST /api/scans/:id/upload's image, in bytes.
# Default 10MB (same as ml-service's own limit).
CIRCUITLOOP_MAX_UPLOAD_BYTES=

# --- Detection (optional) -------------------------------------------------
# Path to the Tesseract OCR binary, only needed if it isn't on PATH or isn't
# at the default Windows install location.
TESSERACT_CMD=

# --- Logging (optional) ---------------------------------------------------
CIRCUITLOOP_LOG_LEVEL=INFO

# --- ESP32 gateway (optional, Phase E/F) ----------------------------------
# Explicit serial port to use (e.g. COM5 on Windows, /dev/ttyUSB0 on Linux).
# Leave blank for automatic detection, which scans every serial port and
# accepts the first whose USB VID:PID is in the allowlist below.
CIRCUITLOOP_ESP32_PORT=
# Baud rate. Defaults to 115200 (the CircuitLoop firmware's rate) if unset.
CIRCUITLOOP_ESP32_BAUD=
# How long to wait for the board's ACK line before giving up on a command.
# Default 5000.
CIRCUITLOOP_ESP32_ACK_TIMEOUT_MS=
# Set false to switch the hardware loop off entirely — no port is scanned or
# opened, GET /api/hardware/status reports state "disabled", and everything
# else in the app behaves exactly as it does today. Default true.
CIRCUITLOOP_ESP32_ENABLED=
# How often (ms) to re-scan serial ports while looking for a board. Default 3000.
CIRCUITLOOP_ESP32_POLL_INTERVAL_MS=
# How long (ms) to wait after a disconnect, ACK timeout, or failed open before
# scanning again. Default 5000.
CIRCUITLOOP_ESP32_RECONNECT_DELAY_MS=
# Action written on connect and on every heartbeat re-probe. Default
# I2C_PROBE:0x27. This is only the automatic probe's default — POST
# /api/hardware/action accepts any non-empty action string.
CIRCUITLOOP_ESP32_DEFAULT_ACTION=
# Comma-separated USB VID:PID pairs (uppercase hex, no 0x) treated as a
# CircuitLoop gateway during auto-detection. Defaults cover CH340, CP2102,
# FTDI, and Espressif native USB. Add your board's pair if it isn't detected
# (find it in Windows Device Manager > Details > Hardware Ids, or `lsusb`).
# Ignored when CIRCUITLOOP_ESP32_PORT names a port explicitly.
CIRCUITLOOP_ESP32_VID_PID_ALLOWLIST=

# --- Internal monitoring (optional, Phase H) ------------------------------
CIRCUITLOOP_HEARTBEAT_STALE_AFTER_S=

# --- CORS (optional) -------------------------------------------------------
# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to http://localhost:5173,http://127.0.0.1:5173 (Vite's dev server
# under both hostnames a browser may use) if unset.
CIRCUITLOOP_CORS_ORIGINS=

# --- Auth & scan image storage ---
# Signs session JWTs. Required — the backend refuses to start without it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Set true only behind HTTPS — a Secure cookie is dropped over plain http://localhost.
COOKIE_SECURE=false
# Where uploaded scan images are written. Relative paths resolve against the
# backend package root, so this stays portable across machines.
CIRCUITLOOP_UPLOAD_DIR=uploads
